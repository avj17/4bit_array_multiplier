set circuit1 [readnet spice /foss/designs/4bit_array_multiplier/pnr/runs/RUN_2026-10-26_17-40-20/68-magic-spiceextraction/mult_array.spice]
set circuit2 [readnet verilog /dev/null]
puts "Reading SPICE netlist file '/foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice'..."
readnet spice /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice $circuit2
puts "Reading SPICE netlist file '/foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spice'..."
readnet spice /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spice $circuit2
puts "Reading Verilog netlist file '/foss/designs/4bit_array_multiplier/pnr/runs/RUN_2026-10-26_17-40-20/52-openroad-fillinsertion/mult_array.pnl.v'..."
readnet verilog /foss/designs/4bit_array_multiplier/pnr/runs/RUN_2026-10-26_17-40-20/52-openroad-fillinsertion/mult_array.pnl.v $circuit2
lvs "$circuit1 mult_array" "$circuit2 mult_array" /usr/local/lib/python3.12/dist-packages/librelane/scripts/netgen/setup.tcl /foss/designs/4bit_array_multiplier/pnr/runs/RUN_2026-10-26_17-40-20/70-netgen-lvs/reports/lvs.netgen.rpt -blackbox -json
